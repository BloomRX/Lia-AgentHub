{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lia Agent Hub Supervised Execution V1",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/operatorAuthorization"
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "request": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "discover"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "submit"
            },
            "requestId": {
              "$ref": "#/$defs/identifier"
            },
            "grantId": {
              "$ref": "#/$defs/identifier"
            },
            "capability": {
              "type": "string",
              "minLength": 1
            },
            "context": {
              "type": "object",
              "required": [
                "text"
              ],
              "additionalProperties": false,
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536,
                  "description": "At most 65536 UTF-8 bytes after decoding; byte length is enforced by the runtime."
                }
              }
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "requestId",
            "grantId",
            "capability",
            "context"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "start"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "status"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "events"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "cancel"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "taskId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "token": {
              "$ref": "#/$defs/token"
            },
            "action": {
              "const": "audit"
            },
            "taskId": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "schemaVersion",
            "token",
            "action",
            "taskId"
          ],
          "additionalProperties": false
        }
      ]
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "ok": {
              "const": true
            },
            "result": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "capabilities": {
                      "type": "array",
                      "items": {
                        "$ref": "#/$defs/requirement"
                      }
                    }
                  },
                  "required": [
                    "capabilities"
                  ],
                  "additionalProperties": false
                },
                {
                  "$ref": "#/$defs/task"
                },
                {
                  "$ref": "#/$defs/ledger"
                },
                {
                  "$ref": "#/$defs/grant"
                },
                {
                  "type": "object",
                  "properties": {
                    "operatorToken": {
                      "$ref": "#/$defs/token"
                    }
                  },
                  "required": [
                    "operatorToken"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "consumer": {
                      "$ref": "#/$defs/identifier"
                    },
                    "token": {
                      "$ref": "#/$defs/token"
                    }
                  },
                  "required": [
                    "consumer",
                    "token"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "schemaVersion",
            "ok",
            "result"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "enum": [
                    "invalid-request",
                    "unauthorized",
                    "forbidden",
                    "conflict",
                    "not-found",
                    "unavailable"
                  ]
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "schemaVersion",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "operatorAuthorization": {
      "type": "object",
      "properties": {
        "operatorToken": {
          "$ref": "#/$defs/token"
        }
      },
      "required": [
        "operatorToken"
      ],
      "additionalProperties": false
    },
    "taskId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "grant": {
      "type": "object",
      "properties": {
        "grantId": {
          "$ref": "#/$defs/taskId"
        },
        "consumer": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "const": "skill.validate"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "grantId",
        "consumer",
        "capability",
        "expiresAt"
      ],
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "const": "skill.validate"
        },
        "revision": {
          "const": 1
        },
        "contextMaxBytes": {
          "const": 65536
        },
        "permission": {
          "const": "skill.validate"
        },
        "grantRequired": {
          "const": true
        }
      },
      "required": [
        "id",
        "revision",
        "contextMaxBytes",
        "permission",
        "grantRequired"
      ],
      "additionalProperties": false
    },
    "taskState": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "taskErrorCode": {
      "enum": [
        "grant-expired",
        "execution-timeout",
        "execution-failed",
        "cancelled"
      ]
    },
    "taskError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/taskErrorCode"
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "validationResult": {
      "type": "object",
      "properties": {
        "counts": {
          "type": "object",
          "properties": {
            "error": {
              "type": "integer",
              "minimum": 0
            },
            "warning": {
              "type": "integer",
              "minimum": 0
            },
            "info": {
              "type": "integer",
              "minimum": 0
            },
            "review": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "error",
            "warning",
            "info",
            "review"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "counts"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "requestId": {
          "$ref": "#/$defs/identifier"
        },
        "capability": {
          "const": "skill.validate"
        },
        "state": {
          "$ref": "#/$defs/taskState"
        },
        "progress": {
          "enum": [
            0,
            100
          ]
        },
        "result": {
          "oneOf": [
            {
              "$ref": "#/$defs/validationResult"
            },
            {
              "const": null
            }
          ]
        },
        "error": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskError"
            },
            {
              "const": null
            }
          ]
        }
      },
      "required": [
        "taskId",
        "requestId",
        "capability",
        "state",
        "progress",
        "result",
        "error"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "queued",
                  "running"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "progress": {
                "const": 0
              },
              "result": {
                "const": null
              },
              "error": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "completed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "progress": {
                "const": 100
              },
              "result": {
                "$ref": "#/$defs/validationResult"
              },
              "error": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "progress": {
                "const": 100
              },
              "result": {
                "const": null
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "enum": [
                      "grant-expired",
                      "execution-timeout",
                      "execution-failed"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "cancelled"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "progress": {
                "const": 100
              },
              "result": {
                "const": null
              },
              "error": {
                "type": "object",
                "properties": {
                  "code": {
                    "const": "cancelled"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "$ref": "#/$defs/taskState"
        },
        "at": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskErrorCode"
            },
            {
              "const": null
            }
          ]
        }
      },
      "required": [
        "sequence",
        "state",
        "at",
        "code"
      ],
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "taskId": {
          "$ref": "#/$defs/taskId"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "required": [
        "taskId",
        "events"
      ],
      "additionalProperties": false
    }
  }
}
